LOG_LEVEL=DEBUG

# SearXNG instance URL (required for both stdio and http transports)

SEARXNG_URL=http://localhost:8888 # default is http://localhost:8888

# Number of results returned by the search tool (default: 10), best scores first.
SEARCH_MAX_RESULTS=10

# Maximum number of characters of page content returned per scrape call (default: 8000, roughly 2000 tokens).
# Longer pages are paginated: the model reads the rest with start_index=next_index.
# Also the upper bound for the optional max_chars parameter sent by the model.
SCRAPE_MAX_CHARS=8000

# --- Headless renderer (optional) ---

# Shared secret between the MCP server and the browserless instance. It is
# appended to SCRAPE_RENDER_URL as ?token=... (unless the URL already has one).
# Local dev default (docker-compose.dev.yml): dev-token
# Production: set a strong value in the deployment environment.
BROWSERLESS_TOKEN=dev-token

# CDP WebSocket endpoint of a headless browser, used for JavaScript-rendered pages.
# Empty (default) disables rendering: pages are fetched over plain HTTP only.
# The BROWSERLESS_TOKEN above is appended automatically.
# Local dev (docker-compose.dev.yml):   ws://localhost:3000
# Production (docker-compose.prod.yml): ws://browser:3000
SCRAPE_RENDER_URL=ws://localhost:3000

# When to render: off | fallback (only JS-only pages) | always.
# Keep off while SCRAPE_RENDER_URL is empty; set fallback (or always) once it is set.
# When SCRAPE_RENDER_MODE is not defined at all, it defaults to fallback if the URL is set.
SCRAPE_RENDER_MODE=always

# Per-render timeout (default: 20s).
SCRAPE_RENDER_TIMEOUT=20s

# Maximum simultaneous renders (default: 1). Each render uses a browser session.
SCRAPE_RENDER_CONCURRENCY=1

# --- Authentication ---

# Shared secret for authenticating MCP HTTP clients (optional for http transport).
# The client must send this value in the X-API-Key header.
X_API_KEY=

# Public-facing base URL of this server.
# Required for Claude Desktop to connect (even without a reverse proxy).
# Example: https://mcp.example.com or https://xxxx.ngrok-free.app
BASE_URL=

# OAuth 2.0 Authorization Server URL (optional for http transport).
# When set, the server acts as an OAuth Resource Server and validates Bearer tokens.
OAUTH_AUTHORIZATION_SERVER=

# Expected audience (aud) claim in the JWT — typically the API identifier in Auth0.
OAUTH_AUDIENCE=

# Comma-separated list of OAuth scopes required to access the MCP endpoints (optional).
OAUTH_SCOPES=

# --- HTTP Server (optional, all values below are defaults) ---

# Interface the HTTP transport binds to (default: localhost).
# Use 0.0.0.0 to accept connections from outside the host (containers, LAN).
HTTP_HOST=localhost

# Port the HTTP transport listens on (default: 8080).
HTTP_PORT=8080

# --- HTTP Security (optional, all values below are defaults) ---

# Maximum requests per second per client IP (default: 50).
HTTP_RATE_LIMIT=50

# Burst capacity per client IP (default: 50).
HTTP_RATE_BURST=50

# HTTP read timeout in seconds (default: 10). Protects against slow request attacks.
HTTP_READ_TIMEOUT=10

# HTTP write timeout in seconds (default: 30). Limits response write duration.
HTTP_WRITE_TIMEOUT=30

# HTTP idle connection timeout in seconds (default: 60). Closes inactive keep-alive connections.
HTTP_IDLE_TIMEOUT=60

# Comma-separated list of trusted proxy IPs or CIDRs (default: empty = trust all).
# When set, X-Forwarded-For is only read from requests originating from these addresses.
# Example: 172.17.0.1,10.0.0.0/8
HTTP_TRUSTED_PROXIES=
